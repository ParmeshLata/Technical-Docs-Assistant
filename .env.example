# Local MiniLM embeddings download approximately 80 MB on the first ingestion.
# Or set EMBEDDING_BACKEND=openai to use the configured embedding API.
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=text-embedding-3-small

# Any OpenAI-compatible Chat Completions endpoint supporting JSON-object responses.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Groq alternative: change the URL to https://api.groq.com/openai/v1,
# set your key, and select a currently available JSON-capable model.

# Only needed for EMBEDDING_BACKEND=openai; kept separate from the chat provider.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1

DATA_DIR=./data/runtime
TOP_K=5
MAX_RETRIES=2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_BYTES=2097152
LLM_TIMEOUT_SECONDS=30
QUERY_TIMEOUT_SECONDS=180
# Optional bonus: one groundedness check after generation. No regeneration loop.
CHECK_GROUNDEDNESS=false
